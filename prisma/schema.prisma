generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LINE
}

enum CardProgressStatus {
  QUEUED
  ASKED
  ANSWERED
}

model User {
  id            String         @id @default(cuid())
  displayName   String?
  authAccounts  AuthAccount[]
  decks         Deck[]
  defaultDeckId String?
  defaultDeck   Deck?          @relation("DefaultDeck", fields: [defaultDeckId], references: [id], onDelete: SetNull)
  progress      CardProgress[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AuthAccount {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Deck {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]
  defaultFor  User[]   @relation("DefaultDeck")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Card {
  id        String         @id @default(cuid())
  deckId    String
  front     String
  back      String
  example   String?
  note      String?
  deck      Deck           @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress  CardProgress[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([deckId])
}

model CardProgress {
  id             String             @id @default(cuid())
  userId         String
  cardId         String
  status         CardProgressStatus @default(QUEUED)
  dueAt          DateTime           @default(now())
  intervalDays   Int                @default(0)
  easeFactor     Float              @default(2.5)
  reviewCount    Int                @default(0)
  askedAt        DateTime?
  answeredAt     DateTime?
  lastReviewedAt DateTime?
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  card           Card               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([userId, cardId])
  @@index([cardId])
  @@index([userId, dueAt])
  @@index([userId, status, dueAt])
}
